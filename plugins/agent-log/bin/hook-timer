#!/usr/bin/env bash
# hook-timer <command...>: runs one settings hook and records how long it took and what it said.
# The engine reports one time per hook event, the whole chain (OTel included), and merges the text of every hook on it,
# so each hook in settings.json is prefixed with this. The hook gets the same stdin, stdout, stderr and exit code as
# unwrapped; its stdout and stderr reach the engine once it exits, which is when the engine reads them anyway.
# Writes one JSON line per run to ~/.claude/hook-times/<session_id>.jsonl, which agent-log reads to time each hook and to
# credit text to the hook that wrote it:
#   {"name":"guard","event":"PreToolUse","use":"toolu_…","agent":null,"t0":<epoch ms>,"t1":<epoch ms>,"exit":0,"say":"guard: …"}
# agent: the subagent's agent_id, null in the main loop
# say: the first line of what the hook handed back (an exit-2 reason, additionalContext, systemMessage, a block reason, or
# stdout on the events where plain stdout is context), cut to 80 code points; null when it said nothing.
# No file extension on purpose: agent-log names a hook by the first `<name>.sh|py|js|…` in its command that starts a word
# or path segment and is no dotfile (the regex below), which must stay the wrapped script, not this one.
# stdin as $(cat) gave it, trailing newlines dropped. A builtin read forks nothing but reads a pipe a byte per syscall, so
# it takes the first 2 KB (most payloads) and cat the rest
rest=
IFS= read -r -d '' -n 2048 input && rest=$(cat)
if [[ $rest ]]; then input+=$rest; else input=${input%"${input##*[!$'\n']}"}; fi
# a pid-named file in the per-user 0700 runtime dir saves mktemp's fork. -O: the dir is ours, not a shared /tmp. Creating
# the file here lets an unusable dir fall back to mktemp (a failed 2>"$errf" would skip the hook); true, since a failed
# redirect on : exits a posix-mode shell
errf=$XDG_RUNTIME_DIR/hook-timer.$$
{ [[ -O $XDG_RUNTIME_DIR ]] && true 2>/dev/null >"$errf"; } || errf=$(mktemp 2>/dev/null) || { "$@" <<<"$input"; exit; } # nowhere to hold stderr: run it unrecorded
t0=${EPOCHREALTIME/./}
out=$("$@" <<<"$input" 2>"$errf"; r=$?; printf x; exit $r) # the x keeps trailing newlines through $( )
rc=$?
t1=${EPOCHREALTIME/./}
out=${out%x}
printf '%s' "$out"
err=
if [[ -s $errf ]]; then cat "$errf" >&2; err=$(head -c 4096 "$errf"); fi # forks only for a hook that wrote to stderr
rm -f "$errf"
# EPOCHREALTIME is bash 5+ (no fork for a clock read); on bash 3.2 (macOS /bin/bash) the hook still runs, unrecorded
[[ -n $t0 && -n $t1 ]] || exit $rc

# the name agent-log gives the hook (scriptName in agent-log.tsx): first script file named, else the command's basename
# a name starts a path segment or word and is no dotfile: `source ~/.vars.sh && ~/hooks/guard.sh` is guard
re='(^|[[:space:]/"'"'"'=;&|(])([[:alnum:]_-][[:alnum:]_.-]*)\.(sh|py|js|mjs|ts|rb|pl)([^[:alnum:]_]|$)'
if [[ "$*" =~ $re ]]; then name=${BASH_REMATCH[2]}; else name=${1##*/}; fi
dir="$HOME/.claude/hook-times"
[[ -d $dir ]] || mkdir -p "$dir" 2>/dev/null
# shellcheck disable=SC2016  # jq program, not shell
{ IFS= read -r sid && IFS= read -r line; } < <(jq -r --arg name "$name" --argjson t0 "$((t0 / 1000))" --argjson t1 "$((t1 / 1000))" \
  --argjson exit "$rc" --arg out "${out:0:65536}" --arg err "$err" '
  def line: [splits("\n") | select(test("\\S"))][0] // null | if . then .[0:80] else . end;
  ($out | try fromjson catch null) as $j
  | (if $exit == 2 then $err
     elif ($j | type) == "object" then
       [$j.hookSpecificOutput.additionalContext?, $j.hookSpecificOutput.permissionDecisionReason?, $j.systemMessage, $j.reason, $j.stopReason]
       | map(select(type == "string" and test("\\S")))[0]
     elif (.hook_event_name | IN("SessionStart", "UserPromptSubmit")) then $out
     else null end) as $said
  | (.session_id // ""),
    ({name: $name, event: .hook_event_name, use: (.tool_use_id // null), agent: (.agent_id // null), t0: $t0, t1: $t1, exit: $exit, say: ($said | if . then line else null end)} | tojson)
  ' <<<"$input" 2>/dev/null)
# one short line per append: concurrent hooks of one event write whole lines
[[ $sid =~ ^[[:alnum:]-]+$ && -n $line ]] && printf '%s\n' "$line" >>"$dir/$sid.jsonl" 2>/dev/null
exit $rc
