#!/usr/bin/env bash
# hook-timer <command...>: runs one settings hook and records how long it took and what it said.
# The engine reports one time per hook event, the whole chain (OTel included), and merges the text of every hook on it,
# so each hook in settings.json is prefixed with this. The hook gets the same stdin, stdout, stderr and exit code as
# unwrapped; its stdout and stderr reach the engine once it exits, which is when the engine reads them anyway.
# Writes one JSON line per run to ~/.claude/hook-times/<session_id>.jsonl, which agent-log reads to time each hook and to
# credit text to the hook that wrote it:
#   {"name":"guard","event":"PreToolUse","use":"toolu_…","t0":<epoch ms>,"t1":<epoch ms>,"exit":0,"say":"guard: …"}
# say: the first line of what the hook handed back (an exit-2 reason, additionalContext, systemMessage, a block reason, or
# stdout on the events where plain stdout is context), cut to 80 chars; null when it said nothing.
# No file extension on purpose: agent-log names a hook by the first `<name>.sh|py|js|…` in its command, which must
# stay the wrapped script, not this one.
input=$(cat)
errf=$(mktemp 2>/dev/null) || { "$@" <<<"$input"; exit; } # nowhere to hold stderr: run it unrecorded
t0=${EPOCHREALTIME/./}
out=$("$@" <<<"$input" 2>"$errf"; r=$?; printf x; exit $r) # the x keeps trailing newlines through $( )
rc=$?
t1=${EPOCHREALTIME/./}
out=${out%x}
printf '%s' "$out"
cat "$errf" >&2
err=$(head -c 4096 "$errf")
rm -f "$errf"
# EPOCHREALTIME is bash 5+ (no fork for a clock read); on bash 3.2 (macOS /bin/bash) the hook still runs, unrecorded
[[ -n $t0 && -n $t1 ]] || exit $rc

# the name agent-log gives the hook (scriptName in agent-log.tsx): first script file named, else the command's basename
if [[ "$*" =~ ([[:alnum:]_.-]+)\.(sh|py|js|mjs|ts|rb|pl)([^[:alnum:]_]|$) ]]; then name=${BASH_REMATCH[1]}; else name=${1##*/}; fi
dir="$HOME/.claude/hook-times"
mkdir -p "$dir" 2>/dev/null
# shellcheck disable=SC2016  # jq program, not shell
{ IFS= read -r sid && IFS= read -r line; } < <(jq -r --arg name "$name" --argjson t0 "$((t0 / 1000))" --argjson t1 "$((t1 / 1000))" \
  --argjson exit "$rc" --arg out "${out:0:65536}" --arg err "$err" '
  def line: [splits("\n") | select(test("\\S"))][0] // null | if . then .[0:80] else . end;
  ($out | try fromjson catch null) as $j
  | (if $exit == 2 then $err
     elif ($j | type) == "object" then
       [$j.hookSpecificOutput.additionalContext?, $j.hookSpecificOutput.permissionDecisionReason?, $j.systemMessage, $j.reason, $j.stopReason]
       | map(select(type == "string" and test("\\S")))[0]
     elif (.hook_event_name | IN("SessionStart", "UserPromptSubmit")) then $out
     else null end) as $said
  | (.session_id // ""),
    ({name: $name, event: .hook_event_name, use: (.tool_use_id // null), t0: $t0, t1: $t1, exit: $exit, say: ($said | if . then line else null end)} | tojson)
  ' <<<"$input" 2>/dev/null)
# one short line per append: concurrent hooks of one event write whole lines
[[ $sid =~ ^[[:alnum:]-]+$ && -n $line ]] && printf '%s\n' "$line" >>"$dir/$sid.jsonl" 2>/dev/null
exit $rc
